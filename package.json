{
  "name": "lens-cycle",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.19.x"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "check:environment": "node scripts/check-environment.mjs",
    "check:storage-architecture": "node scripts/check-storage-architecture.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.include=\"src/**/*.{ts,tsx}\" --coverage.exclude=\"src/**/*.test.{ts,tsx}\" --coverage.exclude=\"src/vite-env.d.ts\" --coverage.thresholds.lines=90 --coverage.thresholds.branches=85",
    "test:watch": "vitest",
    "qa:new-run": "pwsh -NoProfile -File scripts/qa/new-run.ps1",
    "qa:frontend": "pwsh -NoProfile -File scripts/qa/invoke-frontend-gates.ps1",
    "qa:rust": "pwsh -NoProfile -File scripts/qa/invoke-rust-gates.ps1",
    "qa:all": "pwsh -NoProfile -File scripts/qa/invoke-all-gates.ps1",
    "release:windows": "pwsh -NoProfile -File scripts/release/build-windows.ps1",
    "artifacts:clean": "pwsh -NoProfile -File scripts/maintenance/clean-artifacts.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-drag": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "date-fns": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-array": "^3.2.1",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
